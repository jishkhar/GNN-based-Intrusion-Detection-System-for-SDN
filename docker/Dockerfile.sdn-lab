# SDN lab: Mininet + Open vSwitch + os-ken controller + attack tools.
# Build:  docker build -t gnn-ids-lab -f docker/Dockerfile.sdn-lab docker/
# Run:    bash docker/run_lab.sh          (see Docs/sdn_lab_setup.md)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        mininet openvswitch-switch openvswitch-common \
        iproute2 iputils-ping net-tools ethtool procps \
        hping3 nmap iperf3 tcpdump curl netcat-openbsd \
        python3 python3-pip python3-setuptools \
    && rm -rf /var/lib/apt/lists/*

# os-ken: maintained fork of the Ryu controller framework.
RUN pip3 install --no-cache-dir os-ken==2.8.1 requests

COPY lab-entrypoint.sh /usr/local/bin/lab-entrypoint.sh
RUN chmod +x /usr/local/bin/lab-entrypoint.sh
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/lab-entrypoint.sh"]
CMD ["bash"]
